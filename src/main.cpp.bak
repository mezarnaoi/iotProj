#include <Arduino.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Wire.h>
#include <math.h>

// Librarii pentru Bluetooth
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h> // Necesara pentru trimiterea de Notificari

#include "model.h"  

Adafruit_MPU6050 mpu;

// --- Setari BLE ---
BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;

// Acestea sunt "adresele" unice prin care telefonul recunoaste casca
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

// Clasa care monitorizeaza daca un telefon s-a conectat sau deconectat
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      Serial.println("--> Telefon conectat la casca!");
    };

    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      Serial.println("--> Telefon deconectat. Asteptam conexiuni...");
      pServer->getAdvertising()->start(); // Repornim vizibilitatea Bluetooth
    }
};

// --- Setari Senzor si ML ---
const uint32_t SAMPLE_PERIOD_MS = 10; 
uint32_t lastSampleMs = 0;

static float magBuf[WINDOW_SIZE];
static uint16_t magIndex = 0;
static uint16_t sampleCountSinceLastEval = 0;

float logistic(float x) { return 1.0f / (1.0f + expf(-x)); }

void computeFeatures(float &mean_mag, float &std_mag, float &p2p_mag) {
    float tmp[WINDOW_SIZE];
    for (int i = 0; i < WINDOW_SIZE; i++) {
        int idx = (magIndex + i) % WINDOW_SIZE;
        tmp[i] = magBuf[idx];
    }
    float sum = 0.0f, minv = tmp[0], maxv = tmp[0];
    for (int i = 0; i < WINDOW_SIZE; i++) {
        float v = tmp[i];
        sum += v;
        if (v < minv) minv = v;
        if (v > maxv) maxv = v;
    }
    mean_mag = sum / WINDOW_SIZE;
    float varSum = 0.0f;
    for (int i = 0; i < WINDOW_SIZE; i++) {
        float d = tmp[i] - mean_mag;
        varSum += d * d;
    }
    std_mag = sqrtf(varSum / WINDOW_SIZE);
    p2p_mag = maxv - minv;
}

void setup() {
    Serial.begin(115200);
    delay(1000);

    // Initializare senzor
    if (!mpu.begin()) {
        Serial.println("EROARE: MPU6050 nu a fost gasit!");
        while (true) { delay(1000); }
    }
    mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
    mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
    for (int i = 0; i < WINDOW_SIZE; i++) { magBuf[i] = 1.0f; }

    // --- Initializare BLE ---
    Serial.println("Pornire modul Bluetooth...");
    BLEDevice::init("RideGuard_Helmet"); // Numele pe care il vei vedea pe telefon
    pServer = BLEDevice::createServer();
    pServer->setCallbacks(new MyServerCallbacks());

    BLEService *pService = pServer->createService(SERVICE_UUID);

    // Cream caracteristica (cu drept de CITIRE si NOTIFICARE)
    pCharacteristic = pService->createCharacteristic(
                        CHARACTERISTIC_UUID,
                        BLECharacteristic::PROPERTY_READ   |
                        BLECharacteristic::PROPERTY_NOTIFY
                      );

    pCharacteristic->addDescriptor(new BLE2902());
    pCharacteristic->setValue("0"); // Status initial: 0 = OK

    pService->start();
    BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
    pAdvertising->addServiceUUID(SERVICE_UUID);
    pAdvertising->setScanResponse(true);
    BLEDevice::startAdvertising();

    Serial.println("Bluetooth pornit! Poti conecta telefonul.");
}

void loop() {
    uint32_t now = millis();
    if (now - lastSampleMs >= SAMPLE_PERIOD_MS) {
        lastSampleMs = now;
        sensors_event_t a, g, temp;
        mpu.getEvent(&a, &g, &temp);

        float ax = a.acceleration.x / 9.81;
        float ay = a.acceleration.y / 9.81;
        float az = a.acceleration.z / 9.81;
        float mag = sqrtf(ax*ax + ay*ay + az*az);

        magBuf[magIndex] = mag;
        magIndex = (magIndex + 1) % WINDOW_SIZE;
        sampleCountSinceLastEval++;

        if (sampleCountSinceLastEval >= STEP_SIZE) {
            sampleCountSinceLastEval = 0;
            float mean_mag, std_mag, p2p_mag;
            computeFeatures(mean_mag, std_mag, p2p_mag);

            float decision = ShakeModel::W0 + ShakeModel::W1 * mean_mag + 
                             ShakeModel::W2 * std_mag + ShakeModel::W3 * p2p_mag;
            float prob_shake = logistic(decision);

            // Filtrul de sensibilitate pe care l-am setat adineauri
            if (prob_shake > 0.85f && p2p_mag > 2.5f) {
                Serial.println("\n[!!!] ACCIDENT DETECTAT [!!!]");
                
                // Daca avem un telefon conectat, trimitem alerta prin BLE
                if (deviceConnected) {
                    pCharacteristic->setValue("1"); // 1 = Accident
                    pCharacteristic->notify();      // Forteaza telefonul sa citeasca
                    Serial.println("--> Alerta trimisa catre telefon!");
                    
                    delay(3000); // Pauza pt evitarea spam-ului de notificari
                    
                    // Resetam la normal ca sa putem trimite alerte noi pe viitor
                    pCharacteristic->setValue("0");
                    pCharacteristic->notify();
                } else {
                    delay(3000);
                }
                
                for (int i = 0; i < WINDOW_SIZE; i++) { magBuf[i] = 1.0f; }
            }
        }
    }
}